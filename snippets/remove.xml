<?xml version="1.0" encoding="utf-8"?>
<!--
  This is used to track removals of projects that are replaced by tracked repositories.
  Please copy the <project ... /> line from default.xml verbatim,
  paste it below accordingly and change "project" to "remove-project"
-->
<manifest>

  <!-- Replaced by tracked repository (see XOS.xml) -->
  <remove-project path="device/generic/goldfish" name="device/generic/goldfish" groups="pdk" />
  <remove-project path="frameworks/opt/calendar" name="platform/frameworks/opt/calendar" groups="pdk-cw-fs,pdk-fs" />
  <remove-project path="frameworks/opt/colorpicker" name="platform/frameworks/opt/colorpicker" groups="pdk-cw-fs,pdk-fs" />
  <remove-project path="frameworks/opt/timezonepicker" name="platform/frameworks/opt/timezonepicker" groups="pdk-cw-fs,pdk-fs" />
  <remove-project path="platform_testing" name="platform/platform_testing" groups="pdk-fs,pdk-cw-fs,cts,sysui-studio" />

</manifest>
