<?xml version="1.0" encoding="utf-8"?>
<manifest>

  <remote
    name="XOS"
    fetch="https://git.halogenos.org/halogenOS"
    pushurl="git@git.halogenos.org:halogenOS"
    revision="refs/heads/XOS-17.0"
  />

  <project path="build/make" name="android_build_make" remote="XOS" merge-aosp="true">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="external/xos" name="android_external_xos" remote="XOS">
    <linkfile src="devshell/toplevel.envrc" dest=".envrc" />
  </project>
  <project path="manifest" name="android_manifest" remote="XOS" merge-aosp="true">
    <linkfile src="AGENTS.md" dest="AGENTS.md" />
    <linkfile src="CLAUDE.md" dest="CLAUDE.md" />
  </project>

</manifest>
